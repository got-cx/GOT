# Public origin used when building shareable links.
NEXT_PUBLIC_SITE_URL=https://got.cx

# Bare got.cx product API origin. Do not append /api or another path.
NEXT_PUBLIC_GOT_API_URL=https://api.got.cx

# Optional development-only bearer token for a custom API endpoint.
# This is browser-visible; use a dedicated, scoped, revocable development token.
# Token mode omits cookies, so custom APIs may use wildcard CORS in development.
# Production builds ignore this value and use credentialed cookie authentication.
NEXT_PUBLIC_GOT_API_TOKEN=

# Browser-safe Base RPC used to preview deterministic intent addresses.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
# Optional browser-safe fallback Base RPC.
NEXT_PUBLIC_BASE_RPC_FALLBACK=https://base-rpc.publicnode.com
